# 운영 중인 Coin BOT의 systemd 유닛. /etc/systemd/system/coin-bot.service 로 설치한다.
#
# 전용 계정(coinbot)으로 돈다. 같은 서버의 다른 봇들은 바이낸스 키(/etc/coin-bot/coin-bot.env, root 전용),
# DB(/var/lib/coin-bot, coinbot 전용), 프로세스 환경을 읽을 수 없고 코드(/opt/coin-bot, root 전용)도 못 바꾼다.
# 코드 변경은 `sudo coin-bot-deploy` (scripts/deploy.sh)로 배포한다.
#
# 입금 웹훅은 127.0.0.1:804 에서 받는다. 1024 아래 포트는 CAP_NET_BIND_SERVICE가 있어야 열 수 있어서
# 봇이 재시작하는 사이에 다른 계정이 포트를 가로챌 수 없다 (Cloudflare 터널이 이 포트로 넘겨 준다).
#
# 재시작 횟수 제한은 두지 않는다 (StartLimitIntervalSec=0). 제한이 있으면 부팅 때 네트워크가 없거나
# 디스코드 장애로 1분쯤 실패했을 때 봇이 영영 꺼진 채로 남는다. 대신 봇이 스스로 재시작 간격을
# 벌려서(bot/restarts.py) 로그인 과다로 토큰이 초기화되는 일을 막는다.
#
# 이 파일은 coin-bot-deploy로 배포되지 않는다. 바꾸면 직접 복사하고 `systemctl daemon-reload`.

[Unit]
Description=Coin BOT (KRW deposits to coin transfers on Discord)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=coinbot
Group=coinbot
WorkingDirectory=/opt/coin-bot/app
EnvironmentFile=/etc/coin-bot/coin-bot.env
Environment=LANG=C.UTF-8
ExecStart=/opt/coin-bot/venv/bin/python -B -u main.py
Restart=on-failure
RestartSec=10
# SIGTERM을 받으면 종료 기록을 남기고 로그를 비운 뒤 닫는다
KillSignal=SIGTERM
TimeoutStopSec=20

AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/coin-bot
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0077

[Install]
WantedBy=multi-user.target
